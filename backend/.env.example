# Copy to backend/.env and fill in values. Never commit backend/.env.
#
# Create admin:  python create_admin.py
# Create guest:  python create_guest.py
#
# Generate JWT_SECRET_KEY (64 hex chars):
#   python -c "import secrets; print(secrets.token_hex(32))"

ADMIN_USERNAME="your-admin-username"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-bcrypt-hash"
GUEST_USERNAME="guest"
GUEST_PASSWORD="$2b$12$replace-with-bcrypt-hash"
JWT_SECRET_KEY="replace-with-secrets-token-hex-32-output"

# Set for production / Docker / hosted web deployments (requires JWT_SECRET_KEY above)
# PRODUCTION=True

# Comma-separated list of allowed CORS origins for web/cloud deployments.
# Defaults to local dev (Vite) + the Tauri desktop webview if unset.
# CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"
